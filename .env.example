# ==============================================================================
# BHARATQUANT AI: ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Copy to backend/.env and frontend/.env.local respectively
# ==============================================================================

# --- BACKEND (.env) ---
ENV=development
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase Auth & PostgreSQL Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Provider Configuration (anthropic | openai)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Market Data Mode: MOCK | LIVE_BROKER | YFINANCE
MARKET_DATA_MODE=MOCK

# Indian Broker Integration (Optional - Upstox / Dhan)
BROKER_PROVIDER=NONE
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/api/v1/brokers/upstox/callback

# --- FRONTEND (.env.local) ---
NEXT_PUBLIC_APP_NAME="BharatQuant AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000/api/v1"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
